 }
@@ -291,6 +388,8 @@ void ggml_cuda_mul_mat_vec_h(ggml_backend_cuda_context & ctx, const ggml_tensor
         case GGML_TYPE_Q4_0: mmvh_launch_batch<block_q4_0, 0>(src0, src1, dst, h.get(), meta.get(), stream); break;
         case GGML_TYPE_Q8_0: mmvh_launch_batch<block_q8_0, 1>(src0, src1, dst, h.get(), meta.get(), stream); break;
         case GGML_TYPE_Q4_K: mmvh_launch_batch<block_q4_K, 2>(src0, src1, dst, h.get(), meta.get(), stream); break;
+        case GGML_TYPE_Q5_K: mmvh_launch_batch<block_q5_K, 3>(src0, src1, dst, h.get(), meta.get(), stream); break;
