diff --git a/tests/test-backend-ops.cpp b/tests/test-backend-ops.cpp
index 59b163188..1836869c7 100644
--- a/tests/test-backend-ops.cpp
+++ b/tests/test-backend-ops.cpp
@@ -10707,6 +10707,18 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_eval() {
         }
     }
 
+    // MMVH Q5_K/Q6_K: add only missing (type, k, n) combinations, retaining the NMSE limit.
+    for (ggml_type type_a : {GGML_TYPE_Q5_K, GGML_TYPE_Q6_K}) {
+        for (int64_t k : {4096, 14336}) {
+            for (int n = 1; n <= 8; ++n) {
+                if (k == 4096 && (type_a == GGML_TYPE_Q5_K || n == 1 || n == 8)) {
+                    continue; // Q5_K n=1..8 and all_types n=1,8 already covered above.
+                }
+                test_cases.emplace_back(new test_mul_mat(type_a, GGML_TYPE_F32, 129, n, k, {1, 1}, {1, 1}));
+            }
